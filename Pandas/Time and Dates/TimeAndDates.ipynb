    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Add X days/weeks/months/years to a date\\n\",\n",
    "    \"current_date = date.today()\\n\",\n",
    "    \"print(\\\"Current Date:\\\", current_date)\\n\",\n",
    "    \"days_to_add = 10\\n\",\n",
    "    \"new_date = current_date + timedelta(days=days_to_add)\\n\",\n",
    "    \"print(\\\"New Date after adding {} days: {}\\\".format(days_to_add, new_date))\\n\",\n",
    "    \"weeks_to_add = 2\\n\",\n",
    "    \"new_date = current_date + timedelta(weeks=weeks_to_add)\\n\",\n",
    "    \"print(\\\"New Date after adding {} weeks: {}\\\".format(weeks_to_add, new_date))\\n\",\n",
    "    \"# Add years\\n\",\n",
    "    \"years_to_add = 1\\n\",\n",
    "    \"new_date = current_date.replace(year=current_date.year + years_to_add)\\n\",\n",
    "    \"print(\\\"New Date after adding {} years: {}\\\".format(years_to_add, new_date))\\n\",\n",
    "    \"\\n\"\n",
