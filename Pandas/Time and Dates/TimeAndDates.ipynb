    "    \"print(\\\"Parsed Date:\\\", parsed_date)\\n\",\n",
    "    \"print(\\\"Type of Parsed Date:\\\", type(parsed_date))\\n\",\n",
    "    \"print(\\\"Parsed date day of month:\\\", parsed_date.day)\\n\"\n",
